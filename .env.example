# DeepSeek OpenAI-compatible Chat Completions
SENTINELFLOW_LLM_PROVIDER=deepseek
SENTINELFLOW_LLM_API_FORMAT=openai-chat-completions
SENTINELFLOW_LLM_BASE_URL=https://api.deepseek.com
SENTINELFLOW_LLM_MODEL=deepseek-v4-pro
SENTINELFLOW_LLM_API_KEY=replace_with_your_deepseek_api_key

# Deterministic structured candidate review
SENTINELFLOW_LLM_THINKING=disabled
SENTINELFLOW_LLM_TEMPERATURE=0
SENTINELFLOW_LLM_RESPONSE_FORMAT=json_object
SENTINELFLOW_LLM_MAX_TOKENS=4096
SENTINELFLOW_LLM_TIMEOUT_SECONDS=60
SENTINELFLOW_LLM_MAX_RETRIES=2
SENTINELFLOW_LLM_CACHE_DIRECTORY=outputs/cache
